# Root Compose environment. Copy to .env and replace the example credentials.
# Do not use backend/.env for Compose: its SQLite URL is for local development.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
APP_DATABASE=app
AI_DATABASE=ai
DATABASE_URL=postgresql+psycopg://appuser:change-me@db:5432/app
AIENGINE_DATABASE_URL=postgresql://appuser:change-me@db:5432/ai
APP_ENV=demo
AI_ENGINE_ENABLED=false
AIENGINE_TIMEOUT=120
DEEPSEEK_API_KEY=
DEPLOYMENT_TIER=starter
