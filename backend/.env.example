# Application database. SQLite by default; a PostgreSQL URL for deployment.
DATABASE_URL=sqlite:///./backend.db
APP_ENV=local
STORAGE_PATH=./storage
DEPLOYMENT_TIER=starter
DEMO_AUTH=true

# --- ai-engine ---------------------------------------------------------------
# Flip to true to use MaintenanceEngine instead of the offline stub.
AI_ENGINE_ENABLED=false
AIENGINE_TIMEOUT=120
DEEPSEEK_API_KEY=

# The knowledge base. A DIFFERENT store from DATABASE_URL above, even though
# both live in this one process — pgvector only.
AIENGINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai

# Docker Compose uses the root `.env.example`, not this file. Its URLs use the
# `db` service hostname and must be configured with the same credentials as the
# Postgres container. This file is intentionally safe for local SQLite use.

# Replace this demo value outside local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
